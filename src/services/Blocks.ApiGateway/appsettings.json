{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "knowledgehub-route": {
        "ClusterId": "knowledgehub-cluster",
        "Match": {
          "Path": "/api/knowledgehub/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "knowledgehub-cluster": {}
    }
  }
}