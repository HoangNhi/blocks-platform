{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PdfCache": {
    "CacheDirectoryName": "_office_pdf_cache",
    "RetentionMonths": 6,
    "CleanupIntervalHours": 24,
    "ConversionTimeoutSeconds": 60
  }
}
