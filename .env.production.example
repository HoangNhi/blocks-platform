COMPOSE_PROJECT_NAME=blocks_prod
TAG=latest
POSTGRES_DB=blocks
POSTGRES_USER=blocks
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=blocks_prod_postgres_data
API_GATEWAY_PORT=5000
SYSTEM_SERVICE_PORT=5001
FILE_SERVICE_PORT=5002
WEB_PORT=3000
SYSTEM_SERVICE_IMAGE=blocks-example/system-service:latest
FILE_SERVICE_IMAGE=blocks-example/file-service:latest
API_GATEWAY_IMAGE=blocks-example/api-gateway:latest
WEB_IMAGE=blocks-example/web:latest
ASSISTANT_SERVICE_IMAGE=blocks-example/assistant-service:latest
TRADELAB_SERVICE_IMAGE=blocks-example/tradelab-service:latest
SYSTEM_DATABASE_URL=Host=postgres;Port=5432;Database=blocks;Username=blocks;Password=change-me
TRADELAB_DATABASE_URL=postgresql+psycopg://blocks:change-me@postgres:5432/blocks
SYSTEM_JWT_KEY=change-me
FILE_STORAGE_PATH=./data/files