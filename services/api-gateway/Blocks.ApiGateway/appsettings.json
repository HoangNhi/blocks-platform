{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "system-route": {
        "ClusterId": "system-cluster",
        "CorsPolicy": "GatewayCors",
        "Match": {
          "Path": "/api/system/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/system"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "files-route": {
        "ClusterId": "files-cluster",
        "CorsPolicy": "GatewayCors",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/files"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "tradelab-route": {
        "ClusterId": "tradelab-cluster",
        "CorsPolicy": "GatewayCors",
        "Match": {
          "Path": "/api/tradelab/{**catch-all}"
        }
      },
      "assistant-route": {
        "ClusterId": "assistant-cluster",
        "CorsPolicy": "GatewayCors",
        "Match": {
          "Path": "/api/assistant/{**catch-all}"
        }
      },
      "ai-video-route": {
        "ClusterId": "ai-video-cluster",
        "CorsPolicy": "GatewayCors",
        "Match": {
          "Path": "/api/ai-video/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "system-cluster": {
        "Destinations": {
          "systemservice": {
            "Address": "http://127.0.0.1:59990/"
          }
        }
      },
      "files-cluster": {
        "Destinations": {
          "fileservice": {
            "Address": "http://127.0.0.1:59991/"
          }
        }
      },
      "tradelab-cluster": {
        "Destinations": {
          "tradelabservice": {
            "Address": "http://127.0.0.1:8011/"
          }
        }
      },
      "assistant-cluster": {
        "Destinations": {
          "assistantservice": {
            "Address": "http://127.0.0.1:8012/"
          }
        }
      },
      "ai-video-cluster": {
        "Destinations": {
          "aivideoservice": {
            "Address": "http://127.0.0.1:8013/"
          }
        }
      }
    }
  }
}
